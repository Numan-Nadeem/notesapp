# Base URL of the backend API (routes are mounted under /api).
# In production this is the relative path /api, which Vercel rewrites to the
# backend service.
VITE_API_URL=http://localhost:3000/api

# Google OAuth 2.0 Client ID (https://console.cloud.google.com/apis/credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
