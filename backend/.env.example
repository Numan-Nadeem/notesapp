# Server
PORT=3000
NODE_ENV=development

# Allowed frontend origin(s) for CORS — comma-separated.
# Defaults to the Vite dev (5173) and preview (4173) ports.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/notsify

# JWT secrets — use long, random values. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cloudinary credentials (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
